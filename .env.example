# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit the real .env (it is gitignored).
# ============================================================

# Public base URL of the site (used for canonical/OG/sitemap fallbacks)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_APP_URL=https://your-domain.com

# ── Database ────────────────────────────────────────────────
# Prefer a NON-root user with a strong password and least-privilege grants.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DBNAME"
DB_HOST=localhost
DB_PORT=3306
DB_USER=change_me
DB_PASSWORD=change_me
DB_NAME=change_me

# ── Auth ────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
NEXTAUTH_SECRET=generate_a_long_random_value
NEXTAUTH_URL=https://your-domain.com

# ── Realtime (Pusher) ───────────────────────────────────────
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# ── Google Analytics 4 ──────────────────────────────────────
# (1) Public tracking tag (Measurement ID) — makes the site send data to GA.
NEXT_PUBLIC_GA_ID=
# (2) Data API (admin dashboard reads real GA numbers; empty = DB fallback).
GA4_PROPERTY_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=""

# ── Google Search Console (HTML-tag verification token) ─────
NEXT_PUBLIC_GSC_VERIFICATION=

# ── Image uploads ───────────────────────────────────────────
UPLOAD_PROVIDER=local            # local | cloudinary
UPLOAD_MAX_MB=8
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Vision AI (alt-text generator) ──────────────────────────
OPENAI_API_KEY=
GOOGLE_CLOUD_VISION_API_KEY=

# ── SMTP (transactional email) ──────────────────────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Your Name <you@example.com>"

# ── Multi-domain serving (proxy.ts) ──────────────────────────────────────────
# Map each purchased domain to a siteKey. Until this is set, the app runs in
# single-domain dev mode (blog at /, downloader at /yt).
# When you buy the YT downloader domain, set e.g.:
#   SITE_DOMAIN_MAP={"your-yt-domain.com":"yt"}
# Later, when the blog domain arrives, add it:
#   SITE_DOMAIN_MAP={"your-yt-domain.com":"yt","your-blog-domain.com":"blog"}
SITE_DOMAIN_MAP=
# Which site unknown hosts (bare IP, previews) fall back to. Default: blog.
DEFAULT_SITE_KEY=blog
# Optional: comma-separated domains allowed to serve /admin (404 elsewhere).
ADMIN_HOSTS=

# ── YouTube downloader engine ────────────────────────────────────────────────
# Override yt-dlp's player clients if a network blocks certain CDN hosts.
# Default: youtube:player_client=default,android
YT_EXTRACTOR_ARGS=
# Fix for YouTube "Sign in to confirm you're not a bot" (formats limited to 360p):
# export cookies.txt from a logged-in YouTube session (use a throwaway account)
# and point to it here. Alternative: YT_COOKIES_FROM_BROWSER=edge
YT_COOKIES_FILE=
YT_COOKIES_FROM_BROWSER=
