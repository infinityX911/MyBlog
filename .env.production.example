# ============================================================
# PRODUCTION env for the Docker stack.
#   cp .env.production.example .env.production   and fill real values.
# .env.production is read by BOTH docker-compose (DB_* / DB_ROOT_PASSWORD)
# and the app container (everything else). NEVER commit it.
# ============================================================

# ── Public URLs (your real domain, https) ───────────────────
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXTAUTH_URL=https://your-domain.com

# ── Auth secret — generate a fresh one, do NOT reuse the dev value ──
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
NEXTAUTH_SECRET=generate_a_long_random_value

# ── Database ────────────────────────────────────────────────
# DB_HOST MUST be `db` (the compose service name), NOT localhost.
# Use a strong app password + a separate strong root password.
DB_ROOT_PASSWORD=change_me_strong_root_pw
DB_HOST=db
DB_PORT=3306
DB_USER=appuser
DB_PASSWORD=change_me_strong_app_pw
DB_NAME=api
# Prisma CLI (db push) uses this — keep it in sync with the DB_* values above.
DATABASE_URL="mysql://appuser:change_me_strong_app_pw@db:3306/api"

# ── Multi-domain serving (proxy.ts) ─────────────────────────
# Blog-only for now; leave map empty to serve the blog at / on this VPS.
SITE_DOMAIN_MAP=
DEFAULT_SITE_KEY=blog
ADMIN_HOSTS=

# ── Google Analytics 4 ──────────────────────────────────────
# (1) Tracking tag — makes the PUBLIC site actually send data to GA.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# (2) Data API — lets the ADMIN dashboard read real GA numbers.
#     Empty = dashboard falls back to the built-in DB view counts.
GA4_PROPERTY_ID=
GOOGLE_CLIENT_EMAIL=
# Paste the whole key on one line with literal \n between lines, in quotes:
GOOGLE_PRIVATE_KEY=""

# ── Google Search Console ───────────────────────────────────
# The token from GSC "HTML tag" verification (just the content value).
NEXT_PUBLIC_GSC_VERIFICATION=

# ── Sign in with Google (OAuth) ─────────────────────────────
# Google Cloud Console → APIs & Services → Credentials
#   → Create credentials → OAuth client ID → Web application
# Authorised redirect URI (exactly this, no trailing slash):
#   https://theflowsyntax.com/api/auth/callback/google
#
# NOT the same credential as GOOGLE_CLIENT_EMAIL / GOOGLE_PRIVATE_KEY above —
# those are the analytics service account, a different type entirely.
#
# Also remember to PUBLISH the app on the OAuth consent screen. While it sits in
# "Testing" only listed test users can sign in; everyone else sees
# "Access blocked", which looks like a bug in this site rather than a setting.
#
# Leave both blank to switch the feature off: the Google button disappears from
# the login and signup pages and everything else keeps working.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Image uploads ───────────────────────────────────────────
UPLOAD_PROVIDER=local            # local | cloudinary
UPLOAD_MAX_MB=8
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Vision AI (alt-text generator) — optional ───────────────
OPENAI_API_KEY=
GOOGLE_CLOUD_VISION_API_KEY=

# ── SMTP (transactional email) ──────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Your Name <you@example.com>"

# ── Web push (subscriber notifications) — optional ──────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.com

# ── Misc ────────────────────────────────────────────────────
YOUTUBE_API_KEY=
